{
    "name": "up2dev/rivet",
    "description": "A convention-based CRUD/RBAC foundation for building REST APIs with Laravel",
    "minimum-stability": "dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Franz Vetter",
            "homepage": "https://github.com/up2dev"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laravel/framework": ">=10",
        "laravel/sanctum": ">=3",
        "pragmarx/google2fa": "^8.0|^9.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rivet\\": "src",
            "Rivet\\Database\\Factories\\": "database/factories"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Rivet\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rivet\\Providers\\LaravelServiceProvider",
                "Rivet\\Providers\\EventServiceProvider"
            ]
        }
    }
}
